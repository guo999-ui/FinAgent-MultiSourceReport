# ===== 阿里云百炼（DashScope）OpenAI 兼容配置 (最稳定) =====
# 统一使用 OpenAI 的底层逻辑，但把请求转发给阿里云
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
OPENAI_API_KEY="sk-2774e7589e5a45daab3a08be2502e651"

# ===== 对话模型 =====
# 前缀必须保留 openai:，后面跟阿里云的模型名称
FAST_LLM="openai:qwen-plus"
SMART_LLM="openai:qwen-long"
STRATEGIC_LLM="openai:qwen-long"

# ===== 嵌入模型 =====
EMBEDDING="openai:text-embedding-v3"

# ===== 搜索引擎 =====
RETRIEVER="tavily"
TAVILY_API_KEY="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"

# ===== 抓取引擎 =====
# 如果运行后提示缺少 playwright，可以改为 SCRAPER="bs4" 或 "beautifulsoup"
SCRAPER="beautifulsoup"

# ===== 本地文档路径（后续接公众号用）=====
DOC_PATH="./my-docs"

# ===== API 地址 =====
NEXT_PUBLIC_GPTR_API_URL="http://localhost:8000"

# 开启详细日志，方便后续万一卡住时排查原因
LOG_LEVEL=DEBUG

# 研究模式：original (原始), wechat (纯微信), hybrid (全网混合)
RESEARCH_MODE=hybrid
LANGCHAIN_TRACING_V2=false